# WordPress (required unless --dry-run)
WP_URL=https://client.example.com
WP_USER=automation-bot
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_ALLOW_HTTP=false
WP_MIN_REQUEST_INTERVAL_SECONDS=1.0
